<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <!--
      Silence per-statement SQL and connection-pool DEBUG. With no config logback
      defaults the root to DEBUG, so Exposed logs every INSERT and Hikari logs every
      autoCommit reset. During a full chain-sync re-index that synchronous file I/O
      becomes the dominant bottleneck (serialized across all indexer worker threads).
    -->
    <logger name="Exposed" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.ktor" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
