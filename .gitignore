# Backups directory — never commit to git
backups/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/
*.tsbuildinfo
storybook-static/

# Kotlin / Gradle
.gradle/
apps/api/build/
*.jar
# Exceptions that MUST be committed (the global *.jar above is too broad):
#  - the Gradle wrapper jar bootstraps ./gradlew on a fresh checkout (CI)
#  - the vendored patched dependency for CI (see gradle/local-maven/)
!gradle/wrapper/gradle-wrapper.jar
!gradle/local-maven/**/*.jar
*.class

# Environment
.env
.env.local
.env.*.local

# Turbo
.turbo/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
test-results/
.kotlin/

# Superpowers scratch
.superpowers/
